{
  "name": "psych-platform-worker",
  "version": "1.0.0",
  "private": true,
  "description": "学校心理健康筛查与干预管理平台 · Cloudflare Worker",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "preview": "node serve.mjs",
    "db:create": "wrangler d1 create psych-db",
    "db:init": "wrangler d1 execute psych-db --file=./schema.sql",
    "test": "node test-worker.mjs && node test-deploy.mjs",
    "test:deploy": "node test-deploy.mjs"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}